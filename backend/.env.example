# Copy this file to .env and adjust values

# Security
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# Database (SQLite by default, no external DB or docker required)
# For Postgres later: postgresql+psycopg2://user:pass@localhost:5432/dbname
DATABASE_URL=sqlite:///./ve_advisor.db

# CORS - comma separated origins allowed to call this API
CORS_ORIGINS=ve-model.vercel.app


# App
PROJECT_NAME=VE Model Advisor API
ENVIRONMENT=development
